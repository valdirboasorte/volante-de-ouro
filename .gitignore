# Vercel
.vercel

# Dependências (o jogo não usa nenhuma, mas o CLI pode criar)
node_modules/

# Sistema
Thumbs.db
desktop.ini
.DS_Store

# Editores
.vscode/
.idea/
*.swp
.claude/

# Banco histórico: páginas baixadas e leituras intermediárias (o importador refaz)
ferramentas/historico/cache/
ferramentas/historico/brutos/
ferramentas/historico/*.log

# Capturas das ferramentas de design
.taste-skill/inspect/
.taste-skill/telas/
.taste-skill/versoes/
.taste-skill/varredura/

# Traçados do OpenStreetMap: respostas baixadas e registro das rodadas (o importador refaz)
ferramentas/pistas-osm/cache/
ferramentas/pistas-osm/*.log

# Mapas do Wikimedia Commons: respostas e SVGs baixados (o importador refaz)
ferramentas/pistas-svg/cache/

# Notas de trabalho e caches locais
.worker-progress.md
.impeccable/hook.cache.json
